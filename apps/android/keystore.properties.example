# Copy this file to `keystore.properties` (in the same directory) and fill in
# the real values. The actual file is gitignored so credentials never land in
# git history. As an alternative to this file, app/build.gradle.kts also reads
# the same values from environment variables — useful for CI:
#
#   FLOATNATIVE_KEYSTORE_PATH=/abs/path/to/upload-keystore.jks
#   FLOATNATIVE_KEYSTORE_PASSWORD=...
#   FLOATNATIVE_KEY_ALIAS=...
#   FLOATNATIVE_KEY_PASSWORD=...
#
# `storeFile` may be an absolute path or a path relative to apps/android/.
#
# To list aliases that actually exist in your keystore (Android Studio's
# default is usually `key0`, not the project name):
#
#   keytool -list -v -keystore /path/to/your.jks
#

storeFile=/absolute/path/to/your-upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=key0
keyPassword=REPLACE_ME
