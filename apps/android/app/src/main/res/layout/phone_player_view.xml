<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone-side ExoPlayer view. The important attribute here is
    `surface_type="texture_view"` — SurfaceView keeps its original window
    dimensions during PiP transitions on many devices, which is what caused
    GH #41's "video stuck in the top-left of the mini-player" symptom even
    after we corrected the PiP aspect ratio and pre-flipped isInPipMode.
    TextureView re-lays out cleanly with the activity, at the cost of a
    minor decode-path overhead — acceptable for phone playback.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:show_buffering="always"
    app:show_subtitle_button="true"
    app:use_controller="true" />
