{
  "name": "floatnative-browser-extension",
  "version": "1.0.0",
  "description": "Floatplane browser extension for Playlists (Chrome and Firefox)",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "watch": "webpack --config webpack.config.js --watch --mode development",
    "firefox:run": "web-ext run --source-dir dist --target firefox-desktop",
    "firefox:lint": "web-ext lint --source-dir dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/qrcode": "^1.5.6",
    "@types/webextension-polyfill": "^0.12.5",
    "copy-webpack-plugin": "^11.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "web-ext": "^10.4.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "webextension-polyfill": "^0.12.0"
  }
}